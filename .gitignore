# ──────────────────────────────────────────
#  OmniKart — Root .gitignore
#  Place this file inside: ecommerce/
# ──────────────────────────────────────────


# ── Dependencies ──────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/


# ── Environment files (SECRET — never push) 
.env
backend/.env
frontend/.env


# ── Frontend build output ─────────────────
frontend/dist/
frontend/build/


# ── Uploaded files (user images) ──────────
backend/uploads/


# ── Logs ──────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/


# ── OS files ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini


# ── Editor files ──────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln


# ── Misc ──────────────────────────────────
*.zip
.cache/


# ── Test files (EXCLUDED from production) ─
backend/tests/
frontend/src/tests/
backend/jest.config.js
frontend/src/setupTests.js
**/*.test.js
**/*.test.jsx
**/*.spec.js
**/*.spec.jsx
backend/test-email.js
backend/test-scenarios.js
backend/scripts/
