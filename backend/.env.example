# ══════════════════════════════════════════════════════════════════════
#  ShopZone AI — Backend Environment Variables
# ══════════════════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://username:<password>@cluster0.xxxxx.mongodb.net/shopzone?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary (Image Uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── AI Agent System ──────────────────────────────────────────────────

# Redis (required for Bull job queues — the AI agent backbone)
REDIS_URL=redis://127.0.0.1:6379

# Email (Gmail with App Password — used by ALL agents)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Admin notification email (receives AI reports, pricing alerts, etc.)
ADMIN_EMAIL=admin_notification@example.com

# Demo Mode (set to "true" to run agents every 2 minutes for live demo)
DEMO_MODE=true

# ── Chatbot AI Providers ──────────────────────────────────────────────
# Options: groq (recommended), gemini (visual search), openrouter
CHATBOT_PROVIDER=groq

# Groq (Get key: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_key_here

# Gemini (Get key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# OpenRouter (Get key: https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
